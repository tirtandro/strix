# Use the existing sandbox image as base (has all security tools + venv pre-installed)
FROM ghcr.io/usestrix/strix-sandbox:0.1.13

LABEL description="Strix Unified Agent for Google Cloud Run"

USER root
WORKDIR /app

# Update PATH to ensure /app/.venv and system tools are accessible
ENV PATH="/app/.venv/bin:/usr/local/bin:/home/pentester/go/bin:/home/pentester/.local/bin:/home/pentester/.npm-global/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Configure for Cloud Run: use local runtime (no Docker-in-Docker required)
ENV STRIX_RUNTIME_BACKEND=local
ENV STRIX_SANDBOX_MODE=true

# Copy only the updated agent source code.
# The venv and all dependencies are already installed in the base image.
COPY strix/ /app/strix/

# Create the Cloud Run startup script
RUN printf '#!/bin/bash\nset -e\n\nexport TOOL_SERVER_TOKEN=$(openssl rand -base64 32)\nexport TOOL_SERVER_PORT=48081\n\necho "Booting Caido proxy and tool server..."\n/usr/local/bin/docker-entrypoint.sh sleep 1 &\n\necho "Waiting for services (15s)..."\nsleep 15\n\necho "Starting Strix Agent..."\nexec /app/.venv/bin/python -m strix.interface.main "$@"\n' > /usr/local/bin/cloudrun-entrypoint.sh \
    && chmod +x /usr/local/bin/cloudrun-entrypoint.sh

ENTRYPOINT ["cloudrun-entrypoint.sh"]
