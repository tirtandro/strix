# Use the existing sandbox image as base
FROM ghcr.io/usestrix/strix-sandbox:0.1.13

LABEL description="Strix Unified Agent for Google Cloud Run"

USER root
WORKDIR /app

# Ensure PATH includes all essential binary locations
ENV PATH="/app/.venv/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/pentester/.local/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Backend configuration for Cloud Run
ENV STRIX_RUNTIME_BACKEND=local
ENV STRIX_SANDBOX_MODE=true

# Force install 'uv' and rebuild venv to ensure consistency and updated source code
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# Copy updated agent source code
COPY strix/ /app/strix/
COPY pyproject.toml uv.lock ./

# Sync dependencies (venv will be at /app/.venv)
RUN /usr/local/bin/uv sync --frozen --no-dev --extra sandbox --extra vertex

# Copy our specialized Cloud Run entrypoint (handles sudo-less environment)
COPY containers/cloudrun-entrypoint.sh /usr/local/bin/cloudrun-entrypoint.sh
RUN chmod +x /usr/local/bin/cloudrun-entrypoint.sh

# Initialize workspace for scan results
RUN mkdir -p /workspace && chown -R 1000:1000 /workspace /app

# Default entrypoint for Cloud Run
ENTRYPOINT ["/usr/local/bin/cloudrun-entrypoint.sh"]
