# Use the existing sandbox image as base (has all security tools pre-installed)
FROM ghcr.io/usestrix/strix-sandbox:0.1.13

LABEL description="Strix Unified Agent for Google Cloud Run"

# Switch to root to configure the container
USER root

# Set working directory to /app where the agent code lives
WORKDIR /app

# Make sure uv and venv are accessible from PATH for root user
ENV PATH="/usr/local/bin:/home/pentester/go/bin:/home/pentester/.local/bin:/home/pentester/.npm-global/bin:/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"

# Copy dependency files and update agent source code
COPY pyproject.toml uv.lock ./
COPY strix/ /app/strix/

# Install/sync dependencies using the full path (safe across all user contexts)
RUN /usr/local/bin/uv sync --frozen --no-dev --extra sandbox

# Configure environment for Cloud Run (local runtime = no Docker-in-Docker needed)
ENV STRIX_RUNTIME_BACKEND=local
ENV STRIX_SANDBOX_MODE=true
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Create startup script that boots services before running the agent
RUN printf '#!/bin/bash\nset -e\n\nexport TOOL_SERVER_TOKEN=$(openssl rand -base64 32)\nexport TOOL_SERVER_PORT=48081\n\n# Start Caido proxy and tool server in background\n/usr/local/bin/docker-entrypoint.sh sleep 1 &\n\n# Wait for services to fully start\necho "Waiting for services to start..."\nsleep 15\n\n# Launch the Strix agent with any passed arguments\necho "Starting Strix Agent..."\nexec /app/.venv/bin/python -m strix.interface.main "$@"\n' > /usr/local/bin/cloudrun-entrypoint.sh

RUN chmod +x /usr/local/bin/cloudrun-entrypoint.sh

# Default entrypoint for Cloud Run
ENTRYPOINT ["cloudrun-entrypoint.sh"]
