# Gunakan image sandbox sebagai base
FROM ghcr.io/usestrix/strix-sandbox:0.1.13

LABEL description="Strix Unified Agent for Google Cloud Run"

USER root
WORKDIR /app

# Pastikan PATH mencakup semua lokasi penting untuk root
ENV PATH="/app/.venv/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/pentester/.local/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Konfigurasi Runtime Lokal
ENV STRIX_RUNTIME_BACKEND=local
ENV STRIX_SANDBOX_MODE=true

# Update source code agen
COPY strix/ /app/strix/

# Buat ulang script entrypoint dengan path absolut dan pengecekan sederhana
RUN printf '#!/bin/bash\n\
set -e\n\
\n\
export TOOL_SERVER_TOKEN=$(openssl rand -base64 32)\n\
export TOOL_SERVER_PORT=48081\n\
\n\
echo "[INFO] Memberikan izin pada folder workspace..."\n\
mkdir -p /workspace && chown pentester:pentester /workspace\n\
\n\
echo "[INFO] Menjalankan Caido proxy dan tool server di background..."\n\
# Jalankan entrypoint original untuk start Caido, lalu background-kan\n\
/usr/local/bin/docker-entrypoint.sh sleep infinity &\n\
\n\
echo "[INFO] Menunggu layanan siap (20 detik)..."\n\
sleep 20\n\
\n\
echo "[INFO] Menjalankan Strix Agent dengan argumen: $@"\n\
# Jalankan menggunakan python dari venv secara langsung dengan path absolut\n\
exec /app/.venv/bin/python -m strix.interface.main "$@"\n' > /usr/local/bin/cloudrun-entrypoint.sh && \
    chmod +x /usr/local/bin/cloudrun-entrypoint.sh

# Gunakan path absolut untuk ENTRYPOINT
ENTRYPOINT ["/usr/local/bin/cloudrun-entrypoint.sh"]
