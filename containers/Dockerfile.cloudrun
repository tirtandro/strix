# Use the existing sandbox image as base as it has all security tools
FROM ghcr.io/usestrix/strix-sandbox:0.1.13

LABEL description="Strix Unified Agent for Google Cloud Run"

# Switch to root to configure the container
USER root

# Ensure the agent code is up to date (though base image already has it)
COPY pyproject.toml uv.lock ./
COPY strix/ /app/strix/

# Install dependencies if they changed
RUN uv sync --frozen --no-dev --extra sandbox

# Configure environment for Cloud Run
ENV STRIX_RUNTIME_BACKEND=local
ENV STRIX_SANDBOX_MODE=true
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Create a wrapper script to start services and then the agent
COPY <<'EOF' /usr/local/bin/cloudrun-entrypoint.sh
#!/bin/bash
set -e

# Start Caido (Proxy) and other services via the existing entrypoint
# but we'll run it in the background or modify it.
# The original entrypoint starts caido and tool_server then execs $@.

# We need a token for the tool server
export TOOL_SERVER_TOKEN=$(openssl rand -base64 32)
export TOOL_SERVER_PORT=48081

# Start services using the standard entrypoint but pass "sleep infinity" 
# to keep services running while we launch the actual agent.
/usr/local/bin/docker-entrypoint.sh sleep 1 &

# Wait for services to be ready
sleep 10

# Run the strix agent with provided arguments
echo "Starting Strix Agent..."
exec /app/.venv/bin/python -m strix.interface.main "$@"
EOF

RUN chmod +x /usr/local/bin/cloudrun-entrypoint.sh

# Default entrypoint for Cloud Run
ENTRYPOINT ["cloudrun-entrypoint.sh"]
